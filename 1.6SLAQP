import numpy as np
import pandas as pd
from scipy.optimize import minimize

# ==========================================
# 1. 数据准备
# ==========================================
file_path = '1.4pre.csv'
df = pd.read_csv(file_path)

# 提取特征和目标
features = df[['x1', 'x2']].values
target = df['Y'].values

# 【关键步骤】预先计算 TSS (总平方和)，用于后续计算 R^2
# TSS = sum((y - y_mean)^2)
target_mean = np.mean(target)
tss = np.sum((target - target_mean) ** 2)

# ==========================================
# 2. 定义核心函数
# ==========================================
def loss_function(params, X, y):
    a, b, c = params
    y_pred = a * X[:, 0] + b * X[:, 1] + c
    return np.sum((y - y_pred) ** 2)

# 迭代记录器
iteration_history = []

def callback_func(params):
    """
    每次迭代时调用：记录参数、RSS 和 R^2
    """
    # 1. 计算当前的 RSS (Loss)
    current_rss = loss_function(params, features, target)
    
    # 2. 计算当前的 R^2
    # 公式: R^2 = 1 - (RSS / TSS)
    current_r2 = 1 - (current_rss / tss)
    
    # 3. 存入历史记录
    iteration_history.append({
        'params': params.copy(), 
        'loss': current_rss,
        'r2': current_r2
    })

# 约束条件 (保持不变)
constraints = []

# ==========================================
# 3. 执行优化
# ==========================================
initial_guess = [1.0, 1.0, 1.0]

print("开始带 R^2 监控的优化...")
result = minimize(
    loss_function,
    initial_guess,
    args=(features, target),
    method='SLSQP',
    constraints=constraints,
    tol=1e-6,
    callback=callback_func
)

# ==========================================
# 4. 输出包含 R^2 的日志
# ==========================================
if result.success:
    print("\n" + "="*75)
    print("计算机迭代过程日志 (Optimization Log with R^2)")
    print("="*75)
    # 增加了 R^2 列
    print(f"{'Iter':<5} | {'a':<10} | {'b':<10} | {'c':<10} | {'Loss (RSS)':<15} | {'R^2':<10}")
    print("-" * 75)
    
    for i, entry in enumerate(iteration_history):
        p = entry['params']
        # 格式化输出，R^2 保留4位小数
        print(f"{i+1:<5} | {p[0]:.4f}     | {p[1]:.4f}     | {p[2]:.4f}     | {entry['loss']:.4f}          | {entry['r2']:.4f}")
    print("-" * 75)

    # 最终结果
    best_params = result.x
    print(f"\n最终拟合公式: Target = {best_params[0]:.4f}*x1 + {best_params[1]:.4f}*x2 + {best_params[2]:.4f}")
    print(f"最终 R^2: {iteration_history[-1]['r2']:.4f}")

else:
    print("优化失败:", result.message)
